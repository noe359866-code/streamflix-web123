# Puerto del servidor del addon (Stremio usa 7000 por defecto)
PORT=7000

# Dominios de las webs fuente. Solo cámbialos si una web se muda
# de dominio o quieres usar un mirror oficial.
# EA_BASE_URL=https://estrenosanime.net
# INF_BASE_URL=https://infinityanime.net
# JARA_BASE_URL=https://animejara.com
# LAT_BASE_URL=https://latanime.org
# D23_BASE_URL=https://animed23.com

# Tiempos máximos de espera al leer las webs / los servidores (ms)
# EA_TIMEOUT_MS=15000
# EA_EMBED_TIMEOUT_MS=12000

# User-Agent usado al leer las webs (por defecto, Chrome 126)
# EA_USER_AGENT=

# 0 = desactiva los endpoints públicos /debug/* en producción
# DEBUG=0

# Anti-bloqueo de datacenter (VOE/Filemoon/etc.):
# 1) Por defecto, tras un bloqueo se reintenta UNA vez señalando la IP
#    pública de quien pide el stream con X-Forwarded-For. No cambia la
#    IP TCP del servidor (eso no se puede); solo la señala, y solo a ese
#    reproductor. Apágalo con EA_FORWARD_CLIENT_IP=0.
# EA_FORWARD_CLIENT_IP=0
# EA_CLIENT_IP_RETRY_TTL_MS=600000
# EA_TRUST_PROXY=1   # solo si tu proxy inverso no se detecta como salto privado
# 2) Opcional: salida proxy SOLO para resolver embeds bloqueados (el
#    vídeo nunca pasa por el proxy). Lista estática recomendada —
#    pega los endpoints que exporte tu panel (Proxy5 u otro):
# EA_EMBED_PROXY_URLS=http://usuario:clave@203.0.113.10:8080,http://203.0.113.11:8085
# EA_EMBED_PROXY_MAX_ATTEMPTS=2
#    O la API heredada de Proxy5 (solo lectura de la lista; el addon
#    nunca compra ni modifica servicios). La clave es el valor para
#    "Authorization: Basic ..." de su panel, no tu contraseña:
# EA_PROXY5_API_AUTH_KEY=
# EA_PROXY5_SERVICE_ID=
# EA_PROXY5_LIST_TYPE=http-auth   # http-ip | socks-ip | http-auth | ppr-http | ppr-socks
# EA_PROXY5_LIST_FORMAT=json      # json | txt | csv
#    OJO: Proxy5 vende proxies de DATACENTER (su FAQ: no tiene
#    residenciales). Solo ayuda si bloquean la IP/ASN concretas de
#    Beamup. Además exige amarrar (IP binding) la IP saliente de
#    Beamup en su panel, o el proxy rechazará la conexión.
# 3) Opcional: ejecuta scripts/home-resolver.js en una IP residencial
#    (con túnel) y apunta aquí a su URL pública. El token debe coincidir
#    en ambos lados. Ahí sí se resuelve DESDE una IP de casa.
# EA_EXTERNAL_RESOLVER_URL=https://tu-tunel.example
# EA_EXTERNAL_RESOLVER_TOKEN=un-secreto-largo
# EA_EXTERNAL_RESOLVER_TIMEOUT_MS=15000
# EA_HOST_BLOCK_TTL_MS=600000
# EA_HOST_FAILURE_COOLDOWN_MS=60000

# Nota: el addon NO tiene modo demo ni ajustes de usuario en Stremio.
# Estas variables son solo del despliegue; siempre consulta los 5 proveedores.
