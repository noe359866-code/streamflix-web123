# Puerto del servidor del addon (Stremio usa 7000 por defecto)
PORT=7000

# Dominio de la web fuente. Solo cámbialo si estrenosanime se muda
# de dominio o quieres usar un mirror oficial.
# EA_BASE_URL=https://estrenosanime.net

# Tiempos máximos de espera al leer la web / los servidores (ms)
# EA_TIMEOUT_MS=15000
# EA_EMBED_TIMEOUT_MS=12000

# User-Agent usado al leer la web (por defecto, Chrome 126)
# EA_USER_AGENT=

# 1 = si la web no responde, servir catálogos DEMO con datos reales
# de ejemplo (solo para vistas previas/desarrollo SIN internet).
# En producción déjalo sin definir o en 0.
# DEMO_FALLBACK=0

# 0 = desactiva los endpoints públicos /debug/* en producción
# DEBUG=0
